# ==========================================
# Telegram Bot
# ==========================================
# Токен бота от @BotFather
# Пример: 123456789:AAF...
# НЕ коммить реальный токен в Git.
BOT_TOKEN=REPLACE_WITH_BOT_TOKEN

# ==========================================
# PostgreSQL
# ==========================================
# Пользователь базы данных
POSTGRES_USER=romantic_bot

# Пароль базы данных
# На сервере замени на надёжный сгенерированный пароль.
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Имя базы данных
POSTGRES_DB=romantic_bot_db

# Хост PostgreSQL
# Внутри Docker это имя сервиса из docker-compose.yml
POSTGRES_HOST=postgres

# Порт PostgreSQL внутри Docker-сети
POSTGRES_PORT=5432

# ==========================================
# Redis
# ==========================================
# Хост Redis
# Внутри Docker это имя сервиса из docker-compose.yml
REDIS_HOST=redis

# Порт Redis внутри Docker-сети
REDIS_PORT=6379

# Номер базы данных Redis
REDIS_DB=0

# ==========================================
# Application
# ==========================================
# Логировать ли SQL-запросы в консоль
# В продакшене должно быть false
DB_ECHO=false